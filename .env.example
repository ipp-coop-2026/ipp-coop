# Copy to .env.local for local runs. Never commit real values. Server-side only unless the name starts with VITE_.

# AI features (each falls back to a non-AI mode when unset)
GROQ_API_KEY=            # Team 1 FAQ chatbot
ANTHROPIC_API_KEY=       # Launchpad AI tasks, P03 AI reviewer and Internship Desk
AI_DAILY_CAP=150         # daily limit on model calls
DESK_REDIS_URL=          # P03 desk cases shared across devices

# Shared co-op database (Team 5). Reads need nothing: src/lib/db uses the public publishable key.
# VITE_SHARED_DB_URL=https://zbcgneyhwuswyxeaufjh.supabase.co
# VITE_SHARED_DB_KEY=     (only to point at another project)

# Team write keys (ask Team 5 one to one). Each team reads only its own, in its own server route.
P03_TEAM_KEY=            # P03 listing_reviews and listings
P03_WRITE_SCOPE=sandbox  # sandbox = only OP-999; all = every listing except the protected demo thread
# P01_TEAM_KEY=  P02_TEAM_KEY=  P04_TEAM_KEY=  P05_TEAM_KEY=  P06_TEAM_KEY=  P07_TEAM_KEY=
